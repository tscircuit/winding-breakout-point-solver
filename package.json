{
  "name": "@tscircuit/winding-breakout-point-solver",
  "version": "0.0.1",
  "description": "Typed winding-aware PCB breakout-point placement solver",
  "private": true,
  "type": "module",
  "module": "lib/index.ts",
  "files": [
    "lib",
    "examples"
  ],
  "exports": {
    ".": {
      "import": "./lib/index.ts",
      "types": "./lib/index.ts"
    },
    "./examples/am62l": {
      "import": "./examples/am62l/index.ts",
      "types": "./examples/am62l/index.ts"
    }
  },
  "scripts": {
    "start": "cosmos",
    "build": "tsc --noEmit",
    "build:site": "cosmos-export",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "generate:am62l-circuit-json": "bun scripts/generate-am62l-circuit-json.ts",
    "test": "bun test --timeout 60000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tscircuit/solver-utils": "0.0.19",
    "circuit-json": "^0.0.469",
    "graphics-debug": "0.0.99"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@tsci/0hmX.mt53e1g16d1zw-footprint": "1.0.2",
    "@tsci/tscircuit.ti": "1.0.100",
    "@tscircuit/core": "^0.0.1703",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-match-svg": "0.0.16",
    "react": "19.2.8",
    "react-cosmos": "7.3.0",
    "react-cosmos-plugin-vite": "7.3.0",
    "react-dom": "19.2.8",
    "tscircuit": "^0.0.2356",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
